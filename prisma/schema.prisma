// DSA Portal — schema per Specification v1.0 Section 11.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DSA
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutCategory {
  LOAN
  REFERRAL
  INSTITUTION_MEMBER
  INCENTIVE
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  PUBLISHED
  PAID
}

enum DocType {
  PAN
  AADHAAR_FRONT
  AADHAAR_BACK
  PHOTO
  ADDRESS_PROOF
  CHEQUE
}

enum OtpPurpose {
  REGISTER_EMAIL
  REGISTER_MOBILE
  LOGIN
  RESET
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model User {
  id              String            @id @default(uuid())
  role            Role              @default(DSA)
  fullName        String
  email           String            @unique
  emailVerified   Boolean           @default(false)
  mobile          String            @unique
  mobileVerified  Boolean           @default(false)
  passwordHash    String
  status          ApplicationStatus @default(PENDING)
  rejectionReason String?

  // Issued only on approval. Institution code is PRIVATE, refer code is PUBLIC.
  institutionCode String? @unique
  referCode       String? @unique

  referredById String?
  referredBy   User?   @relation("Downline", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Downline")

  // Refer code as typed at registration, retained even if the referrer is later deleted.
  submittedReferCode String?

  profile     DsaProfile?
  bankDetails BankDetails?
  documents   DsaDocument[]
  payouts     Payout[]        @relation("PayoutRecipient")
  createdPayouts Payout[]     @relation("PayoutCreator")
  notifications Notification[]
  auditLogs   AuditLog[]

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([referredById])
  @@index([role, status])
}

model DsaProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dob          DateTime
  gender       String?
  guardianName String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String

  panNumber String @unique
  // Stored encrypted at rest; never returned raw to the client.
  aadhaarNumber String
  aadhaarLast4  String
  photoUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DsaDocument {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType  DocType
  fileUrl  String
  publicId String?
  verified Boolean @default(false)

  uploadedAt DateTime @default(now())

  @@index([userId])
}

model BankDetails {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountHolderName String
  bankName          String
  // Encrypted at rest; only the last 4 digits are shown in the UI.
  accountNumber     String
  accountLast4      String
  ifsc              String
  verified          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payout {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("PayoutRecipient", fields: [userId], references: [id], onDelete: Cascade)

  // First day of the payout month, e.g. 2026-05-01.
  month    DateTime
  category PayoutCategory
  loanType String?

  amount     Decimal @db.Decimal(12, 2)
  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  slipFileUrl      String?
  slipFilePublicId String?
  remarks          String?

  status PayoutStatus @default(PENDING)

  createdById String?
  createdBy   User?   @relation("PayoutCreator", fields: [createdById], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, month])
  @@index([month, status])
}

model Notification {
  id     String  @id @default(uuid())
  // Null recipient means a broadcast announcement.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  message  String
  type     String
  channels NotificationChannel[]

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id          String  @id @default(uuid())
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  meta     Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model OtpCode {
  id         String     @id @default(uuid())
  identifier String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([identifier, purpose])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
