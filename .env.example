# ── Database ────────────────────────────────────────────────────────────────
# Any Postgres 14+ URL. Neon / Supabase / Railway free tiers all work.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/yfs_portal?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs the session JWT. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# ── PII encryption ──────────────────────────────────────────────────────────
# AES-256-GCM key for Aadhaar + bank account numbers at rest.
# Must be exactly 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
# WARNING: changing this makes existing encrypted data unreadable.
ENCRYPTION_KEY=""

# ── File storage ────────────────────────────────────────────────────────────
# "disk" (default) writes KYC documents and salary slips to UPLOAD_DIR. On
# Dokploy, mount a volume at that path or every redeploy loses them.
# "cloudinary" offloads to a CDN instead and needs the CLOUDINARY_* values.
STORAGE_DRIVER="disk"
UPLOAD_DIR=""

# Only used when STORAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── App ─────────────────────────────────────────────────────────────────────
# Marks the session cookie Secure. Inferred from NEXT_PUBLIC_APP_URL: https
# turns it on, http leaves it off so an HTTP test domain can log in. Set
# explicitly only if you need to override that.
COOKIE_SECURE=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Development conveniences ────────────────────────────────────────────────
# With no mail/SMS provider wired up, set OTP_ECHO=1 to return the OTP to the
# caller so you can complete registration and login locally. Hard-gated on
# NODE_ENV: it has no effect in production. Never set this on a live server.
OTP_ECHO="1"

# ── Email delivery (SMTP) ───────────────────────────────────────────────────
# When these are set, OTPs and notifications are sent for real. When unset,
# they are logged to the server console instead.
#
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="YFS Infinity <no-reply@yfsinfinity.com>"
